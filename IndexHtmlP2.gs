ed=false;btn.innerText='Log In';\n    if(r.success){currentUser=r.user;loadDashboard()}else{err.innerText=r.message;err.style.display='block'}\n  }).withFailureHandler(e=>{btn.disabled=false;btn.innerText='Log In';err.innerText=e.message;err.style.display='block'}).loginUser(userId,pass);\n}\nfunction loadDashboard(){\n  document.getElementById('loginView').classList.remove('active');\n  document.getElementById('appView').classList.add('active');\n  document.getElementById('displayUserName').innerText=currentUser.name;\n  const a=currentUser.role==='admin';\n  document.getElementById('adminBadge').style.display=a?'inline-flex':'none';\n  document.getElementById('adminMenuBtn').style.display=a?'block':'none';\n  const n=new Date();\n  document.getElementById('shiftYear').value=n.getFullYear();\n  document.getElementById('shiftMonth').value=n.getMonth()+1;\n  google.script.run.preloadLeaveEntryData();\n  loadReportFilters();\n  // Default: show recent leave records until an employee is selected\n  fetchHistoryTable(null);\n}\nfunction logout(){currentUser=null;loadedEmployee=null;document.getElementById('appView').classList.remove('active');document.getElementById('loginView').classList.add('active')}\nfunction switchModule(el){\n  document.querySelectorAll('.menu-item').forEach(e=>e.classList.remove('active'));\n  el.classList.add('active');\n  document.querySelectorAll('.module').forEach(e=>e.classList.remove('active'));\n  document.getElementById(el.dataset.target).classList.add('active');\n}\n\n/* ---- Employee search: Enter = first match, Escape = close ---- */\nfunction handleEmployeeSearch(){\n  clearTimeout(employeeSearchTimer);\n  const q=document.getElementById('formEmpId').value.trim();\n  const p=document.getElementById('employeeSuggestions');\n  if(q.length<1){p.style.display='none';empSuggestions=[];return}\n  employeeSearchTimer=setTimeout(()=>{\n    google.script.run.withSuccessHandler(r=>{\n      empSuggestions=r||[];empSuggestIdx=empSuggestions.lengt