message,!r.success);\n    if(r.success){\n      document.getElementById('startDate').value='';\n      document.getElementById('endDate').value='';\n      document.getElementById('leaveReason').value='';\n      const m=(r.message||'').match(/([A-Z]{1,4}-\\d+)/);\n      if(m)document.getElementById('lastEntryCode').innerText='Last entry: '+m[1];\n      fetchEmployeeDetails();\n    }\n  }).withFailureHandler(e=>{\n    btn.disabled=false;btn.innerText='Submit Request';\n    toast(e.message,true);\n  }).submitLeaveRequest({\n    empId:loadedEmployee.id,empName:loadedEmployee.name,dept:loadedEmployee.dept,\n    category:loadedEmployee.category,bu:loadedEmployee.bu,leaveType,startDate,endDate,leaveReason,\n    availableBalance:bal.balance==='Unlimited'?999999:Number(bal.balance||0)\n  },currentUser);\n}\n\nfunction fetchHistoryTable(empId){\n  const tbody=document.getElementById('historyTableBody');\n  tbody.innerHTML='<tr><td>Loading\u2026</td></tr>';\n  const handler=function(h){\n    lastHistoryRows=h||[];\n    if(!h||!h.length){tbody.innerHTML='<tr><td>No records</td></tr>';return}\n    tbody.innerHTML='<tr><th>Entry Code</th><th>Emp ID</th><th>Name</th><th>Start</th><th>End</th><th>Days</th><th>Leave Year</th><th>Type</th><th></th></tr>'+\n      h.map(r=>{\n        const s=toInputDate(r.startDate),e=toInputDate(r.endDate);\n        const reason=escapeHtml(r.reason||'').replace(/`/g,'&#96;');\n        const type=escapeHtml(r.type||'');\n        return '<tr><td><b>'+escapeHtml(r.entryCode||'')+'</b></td><td>'+escapeHtml(r.empId)+'</td><td>'+escapeHtml(r.empName)+'</td><td>'+s+'</td><td>'+e+'</td><td>'+escapeHtml(r.noOfDays)+'</td><td>'+escapeHtml(r.entitlementYear)+'</td><td>'+type+'</td><td><button class=\"btn ghost\" onclick=\"openEditModal(`'+escapeHtml(r.entryCode)+'`,`'+s+'`,`'+e+'`,`'+reason+'`,`'+type+'`)\">Edit</button></td></tr>';\n      }).join('');\n  };\n  if(empId){\n    google.script.run.withSuccessHandler(handler).withFailureHandler(e=>{tbody.innerHTML='<tr><td>'+escapeHtml(e.message)+'</td></tr>'}).getEmployeeLeaveHistory(empId);\n  }else{\n    google.script.run.withSuccessHandler(handler).withFailureHandler(e=>{tbody.innerHTML='<tr><td>'+escapeHtml(e.message)+'</td></tr>'}).getRecentLeaveRecords(50);\n  }\n}\n\nfunction exportHistoryCsv(){\n  const empId=loa";
