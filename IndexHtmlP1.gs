f(m)return m[1]+'-'+m[2]+'-'+m[3];\n    var mon=v.match(/(\\d{1,2})-([A-Za-z]{3})-(\\d{2,4})/);\n    if(mon){\n      var months={jan:'01',feb:'02',mar:'03',apr:'04',may:'05',jun:'06',jul:'07',aug:'08',sep:'09',oct:'10',nov:'11',dec:'12'};\n      var mi=months[mon[2].toLowerCase()];\n      if(mi){var y=mon[3].length===2?(Number(mon[3])>=70?'19':'20')+mon[3]:mon[3];return y+'-'+mi+'-'+('0'+mon[1]).slice(-2)}\n    }\n  }\n  try{\n    var d=new Date(v);\n    if(!isNaN(d.getTime())){\n      if(d.getUTCHours()===0&&d.getUTCMinutes()===0&&d.getUTCSeconds()===0){\n        return d.getUTCFullYear()+'-'+('0'+(d.getUTCMonth()+1)).slice(-2)+'-'+('0'+d.getUTCDate()).slice(-2);\n      }\n      return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2);\n    }\n  }catch(e){}\n  return '';\n}\nfunction toDateTimeLocal(v){\n  if(v==null||v==='')return '';\n  var d=new Date(v);if(isNaN(d.getTime()))return String(v);\n  return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2)+' '+('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);\n}\nfunction clearFieldErrors(){\n  document.querySelectorAll('.field-error').forEach(el=>el.classList.remove('field-error'));\n  const fe=document.getElementById('leaveFormError');if(fe){fe.style.display='none';fe.innerText=''}\n}\nfunction markError(id){const el=document.getElementById(id);if(el)el.classList.add('field-error')}\n\nfunction handleLoginKey(event){if(event.key==='Enter'){event.preventDefault();attemptLogin()}}\nfunction showResetPanel(){document.getElementById('resetPanel').style.display='block';document.getElementById('resetUserId').value=document.getElementById('userId').value.trim()}\nfunction loadSecurityQuestion(){\n  const uid=document.getElementById('resetUserId').value.trim(),msg=document.getElementById('resetMsg');\n  if(!uid){msg.innerText='Enter User ID';msg.style.display='block';return}\n  google.script.run.withSuccessHandler(r=>{\n    if(!r.success){msg.innerText=r.message;msg.style.display='block';return}\n    msg.style.display='none';document.getElementById('securityQuestionText').innerText=r.question;document.getElementById('questionBox').style.display='block';\n  }).getSecurityQuestion(uid);\n}\nfunction submitPasswordReset(){\n  const uid=document.getElementById('resetUserId').value.trim(),ans=document.getElementById('resetAnswer').value,msg=document.getElementById('resetMsg');\n  google.script.run.withSuccessHandler(r=>{msg.style.display='block';msg.style.color=r.success?'#16a34a':'#dc2626';msg.innerText=r.message}).resetPasswordWithAnswer(uid,ans);\n}\nfunction toggleSidebar(){document.quer";
