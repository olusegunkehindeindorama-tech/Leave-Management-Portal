\"recalcBtn\">Recalculate all Leave Utilized</button>\n        </div>\n        <p id=\"recalcStatus\" style=\"font-size:13px;color:var(--muted);margin-top:12px\"></p>\n      </div>\n      <div class=\"card actions\">\n        <button class=\"btn success\" onclick=\"runDarwinBoxImport()\">Import DarwinBox</button>\n        <button class=\"btn\" onclick=\"downloadDarwinBoxExport()\">Export for DB</button>\n        <button class=\"btn secondary\" onclick=\"runEmployeeSync()\">Sync Employees</button>\n        <button class=\"btn warning\" onclick=\"runExcelLeaveImport()\">Excel Leave Import</button>\n      </div>\n      <div class=\"card\">\n        <h3>Employee master sync</h3>\n        <p style=\"color:var(--muted);font-size:14px;margin-top:0\">Reads Employee List for Leave.csv, updates tblEmployee, refreshes balances.</p>\n        <div class=\"actions\"><button class=\"btn secondary\" onclick=\"runEmployeeSync()\">Sync Employees from CSV</button></div>\n      </div>\n      <div class=\"card\">\n        <h3>Leave data cleanup</h3>\n        <p style=\"color:var(--muted);font-size:14px;margin-top:0\">Deduplicates emp|start|end, resolves overlaps, recalculates utilization.</p>\n        <div class=\"actions\"><button class=\"btn warning\" onclick=\"runLeaveCleanupPipeline()\">Run Leave Cleanup Pipeline</button></div>\n      </div>\n      <div class=\"card\">\n        <h3>Shift from Drive</h3>\n        <p style=\"color:var(--muted);font-size:14px;margin-top:0\">Processes shift CSV/xlsx into wide tblShift.</p>\n        <div class=\"actions\"><button class=\"btn warning\" onclick=\"runShiftImport()\">Process Drive Shift Files</button></div>\n      </div>\n      <p id=\"adminStatus\" style=\"font-size:13px;color:#64748b\"></p>\n    </section>\n  </main>\n</div>\n\n<div id=\"editModal\" class=\"modal-backdrop\"><div class=\"modal-card\">\n  <h2>Edit Leave</h2>\n  <p>Code: <b id=\"editEntryCode\"></b></p>\n  <div class=\"input-group\"><label>Leave Type</label><select id=\"editL